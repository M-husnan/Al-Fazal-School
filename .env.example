# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional for PostgreSQL. Leave empty to use local SQLite for a quick demo.
DATABASE_URL=postgresql://school_user:school_password@localhost:5432/alfazal_school
DATABASE_SSL_REQUIRED=false

# Optional for multi-worker production WebSockets. Without Redis, only in-process
# development works and connections do not share state between server processes.
REDIS_URL=redis://localhost:6379/0

# Optional S3-compatible media storage (AWS S3, Cloudflare R2, etc.).
# Configure bucket access/public URL according to your provider.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_MEDIA_URL=

# Frontend Vite build setting. Include the trailing /api/.
VITE_API_URL=http://127.0.0.1:8000/api/
